package {{.Name}}

var (
	allocMu sync.Mutex
	allocs  = make(map[uint32][]byte)
)

//go:wasmexport malloc
func wasm_malloc(n uint32) uint32 {
	if n == 0 {
		return 0
	}
	buf := make([]byte, n)
	ptr := uint32(uintptr(unsafe.Pointer(unsafe.SliceData(buf))))
	allocMu.Lock()
	allocs[ptr] = buf
	allocMu.Unlock()
	return ptr
}

func wasm_free(ptr uint32) {
	if ptr == 0 {
		return
	}
	allocMu.Lock()
	delete(allocs, ptr)
	allocMu.Unlock()
}

