module env

decl Color struct {	R u8; G u8; B u8; A u8 }
decl BlockType struct {	
	Name string
	Color Color
	IsSolid bool
}

decl log-info(msg string)()
decl log-warn(msg string)()
decl log-error(msg string)()

decl reg-add-block(block *BlockType)(namespaceid string)
decl reg-get-block(namespaceid string)(block BlockType, err error)
decl append-lang(name string)(err error)

decl config-set-int(name string, value i64)()
decl config-set-float(name string, value f64)()
decl config-set-string(name string, value string)()

decl config-get-int(name string)(value i64)
decl config-get-float(name string)(value f64)
decl config-get-string(name string)(value string)